generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Service {
  id          String  @id
  name        String
  description String
  price       String
  duration    String
  icon        String
  featured    Boolean @default(false)
  order       Int     @default(0)
}

model Barber {
  id         String @id
  name       String
  specialty  String
  experience String
  bio        String
  initials   String
  order      Int    @default(0)
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  phone     String
  branchId  String
  serviceId String
  barberId  String?
  date      DateTime
  time      String
  notes     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}
