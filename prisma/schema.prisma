generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  phone     String
  branchId  String
  serviceId String
  barberId  String?
  date      DateTime
  time      String
  notes     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
